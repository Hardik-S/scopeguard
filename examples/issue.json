{
  "schema_version": 1,
  "id": "owned-python-fix",
  "title": "Change implementation while preserving the verifier",
  "allowed_paths": [
    "scopeguard/"
  ],
  "forbidden_paths": [
    "tests/",
    "SPEC.md",
    "examples/issue.json"
  ],
  "checks": [
    {
      "id": "regressions",
      "argv": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "timeout_seconds": 120
    }
  ]
}

